# ============ LLM（Qwen3-14B-AWQ，vLLM OpenAI 兼容接口，单卡 16GB）============
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-14b
LLM_API_KEY=dummy
TEMPERATURE=0.7
# Qwen3 混合思考模式：RAG 场景建议关闭思考，响应更快
DISABLE_THINKING=true

# ============ Embedding（bge-m3，1024 维，vLLM pooling 服务）============
EMBED_BASE_URL=http://localhost:8001/v1
EMBED_MODEL=bge-m3
EMBED_API_KEY=dummy

# ============ 知识库 ============
CHROMA_DIR=./data/chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=6
# 相似度阈值（cosine 相似度 = 1 - 距离），低于该值视为未命中 → LLM 兜底
SIM_THRESHOLD=0.35
# 跨语言检索：查询自动改写+中英互译，双路召回（中文问题命中英文资料）
CROSS_LINGUAL=true

# ============ 服务（注意：8000 已被 vLLM LLM 占用，后端用 8010）============
HOST=0.0.0.0
PORT=8010

# ============ OCR（扫描件自动识别，PP-OCRv6，运行于独立 paddle 环境 / CPU，页级自适应）============
OCR_ENABLED=true
OCR_PYTHON=/home/zpmc/miniconda3/envs/paddle/bin/python
OCR_MIN_CHARS_PER_PAGE=20
OCR_TIMEOUT=600
# 速度优先：small 模型 + 1.5x 渲染 + 8 线程；要更高精度改 OCR_MODEL_SIZE=medium
OCR_MODEL_SIZE=small
OCR_SCALE=1.5
OCR_CPU_THREADS=8
# 页面快照：扫描页 + 矢量绘图密集页渲染为整页图（矢量架构图的呈现来源）
PAGE_SNAPSHOTS=true
SNAPSHOT_DRAWINGS=40
SNAPSHOT_MAX=60
